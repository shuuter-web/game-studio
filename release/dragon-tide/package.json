{
  "name": "dragon-tide-release",
  "version": "0.0.0",
  "private": true,
  "description": "Dragon Tide store build tooling; game version is read from the shared HTML",
  "engines": { "node": ">=22" },
  "scripts": {
    "check": "node scripts/check.mjs",
    "test": "node --test tests/*.test.mjs",
    "build:web": "node scripts/build-web.mjs",
    "build:windows": "node scripts/build-windows.mjs",
    "mobile:sync": "node scripts/mobile.mjs",
    "steam:prepare": "node scripts/steam.mjs",
    "release:next": "node scripts/next-release.mjs",
    "test:desktop": "node scripts/smoke-desktop.mjs"
  },
  "dependencies": {
    "@capacitor/android": "8.6.0",
    "@capacitor/core": "8.6.0",
    "@capacitor/ios": "8.6.0"
  },
  "devDependencies": {
    "@capacitor/cli": "8.6.0",
    "electron": "45.2.1",
    "electron-builder": "26.18.0"
  }
}
